{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DrivoDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "DrivoApi",
    "Audience": "DrivoApp",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Maps": {
    "UserAgent": "DrivoApp/1.0 (student project)",
    "PhotonUrl": "https://photon.komoot.io",
    "NominatimUrl": "https://nominatim.openstreetmap.org",
    "OsrmUrl": "https://router.project-osrm.org"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
